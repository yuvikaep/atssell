# Copy to .env. Values below match the local cluster created by `npm run db:init`.

# Web app role: NOBYPASSRLS, so Row-Level Security applies to every query.
DATABASE_URL=postgres://jm_app@localhost:5433/jobsmato
# Owner/superuser: migrations, tenant provisioning, seeds. Never used by the web server.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5433/jobsmato

TEST_DATABASE_URL=postgres://jm_app@localhost:5433/jobsmato_test
TEST_DATABASE_URL_ADMIN=postgres://postgres@localhost:5433/jobsmato_test

# Role that migrations grant table access to.
APP_DB_ROLE=jm_app

API_PORT=3000
WEB_ORIGIN=http://localhost:5180
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60
# Salt for hashing client IPs in audit events. Use a long random value in every real environment.
IP_HASH_SALT=dev-only-change-me

# Resume storage. Local disk in development; S3 (private bucket, Mumbai region) before pilot.
STORAGE_DIR=.storage
# HMAC secret for short-lived resume download links. Use a long random value in every real environment.
FILE_URL_SECRET=dev-only-file-secret-change-me
FILE_URL_TTL_SECONDS=300

# --- Outside services (production requires s3 + clamav + smtp) ---
# STORAGE_DRIVER=s3
# S3_BUCKET=rms-prod-files
# S3_REGION=ap-south-1
# S3_PREFIX=
# S3_ENDPOINT=            # only for S3-compatible stores such as MinIO
# SCANNER_DRIVER=clamav
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# MAIL_DRIVER=smtp
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="RMS <no-reply@example.com>"

# --- Hosting on Vercel (see docs/VERCEL.md) ---
# DB_POOL_MAX=3                    # connections per function instance; use Neon's pooled (-pooler) URL for DATABASE_URL
# CRON_SECRET=<random 32+ chars>   # Vercel Cron sends it; enables /api/v1/cron/worker
# ALLOWED_ORIGINS=https://jobs.example.com   # extra origins such as a custom domain (comma separated)
# SCANNER_DRIVER=http              # ClamAV through scanner-service/ over HTTPS
# SCANNER_URL=https://scanner.example.com/scan
# SCANNER_TOKEN=<random 32+ chars, same as the scanner service>
