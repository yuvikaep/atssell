{
  "name": "rms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:init": "bash scripts/db.sh init",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:migrate": "npm run -w server db:migrate",
    "db:seed": "npm run -w server db:seed",
    "tenant:create": "npm run -w server tenant:create --",
    "dev": "concurrently -n api,web -c blue,green \"npm run -w server dev\" \"npm run -w web dev\"",
    "test": "npm run -w server test",
    "typecheck": "npm run -w server typecheck && npm run -w web typecheck",
    "build": "npm run -w server build && npm run -w web build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
