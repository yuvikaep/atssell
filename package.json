{
  "name": "jobsmato-ats",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "db:init": "bash scripts/db.sh init",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:migrate": "npm run -w api db:migrate",
    "db:seed": "npm run -w api db:seed",
    "tenant:create": "npm run -w api tenant:create --",
    "dev": "concurrently -n api,web -c blue,green \"npm run -w api dev\" \"npm run -w web dev\"",
    "test": "npm run -w api test",
    "typecheck": "npm run -w api typecheck && npm run -w web typecheck",
    "build": "npm run -w api build && npm run -w web build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
