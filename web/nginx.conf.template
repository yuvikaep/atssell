# The visitor's address for the API's rate limits and audit log. Behind a Cloudflare tunnel every request
# comes from the tunnel, so the real address is Cloudflare's CF-Connecting-IP header. That header is only
# trustworthy when nothing else can reach this server, hence the TRUST_CF_CONNECTING_IP switch.
map $http_cf_connecting_ip $cf_client_ip {
  ""      $remote_addr;
  default $http_cf_connecting_ip;
}
map "${TRUST_CF_CONNECTING_IP}" $client_ip {
  on      $cf_client_ip;
  default $remote_addr;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 26m;   # resume uploads are capped at 25 MB by the API

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  # One-time links carry their token in the fragment; the page must never leak it onward.
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location /api/ {
    proxy_pass http://api:3000;
    proxy_set_header Host $host;
    # One address, replacing anything the client sent; the API trusts the first entry.
    proxy_set_header X-Forwarded-For $client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed build assets can be cached for a long time; the HTML shell must not be.
  # The API's health check, so a monitor on the site's own address checks nginx, the API and its start-up.
  location = /health { proxy_pass http://api:3000/health; }

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
  location / { add_header Cache-Control "no-store"; try_files $uri /index.html; }
}
