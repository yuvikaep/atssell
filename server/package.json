{
  "name": "@jobsmato/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=../.env scripts/seed-dev.ts",
    "tenant:create": "tsx --env-file=../.env scripts/create-tenant.ts",
    "load-test": "tsx --env-file=../.env scripts/load-test.ts",
    "pilot:baseline": "tsx --env-file=../.env scripts/pilot-baseline.ts",
    "retention:report": "tsx --env-file=../.env scripts/retention-report.ts",
    "seed:demo": "tsx --env-file=../.env scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
